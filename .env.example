# .env.example — 복사해서 .env 로 쓴다(.env는 커밋 금지).
# 이 저장소는 가짜 광고 API(fake)로만 동작한다. 아래 키는 실연동 어댑터를 붙일 때의 자리다.

# fake | live (live 어댑터는 아직 구현하지 않음: adops/adapters/*_like.py 의 *LiveAdapter 참고)
DEMO_MODE=fake

# 작업 폴더(가상 데이터·감사 로그·브리핑). 비우면 .adops
ADOPS_HOME=

# 검색광고형 실연동 자리 (예: 네이버 검색광고 API)
SEARCHAD_API_KEY=
SEARCHAD_SECRET_KEY=
SEARCHAD_CUSTOMER_ID=

# 메타형 실연동 자리 (Graph API 시스템 사용자 토큰)
META_ACCESS_TOKEN=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
